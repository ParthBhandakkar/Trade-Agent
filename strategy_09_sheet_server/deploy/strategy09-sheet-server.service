[Unit]
Description=Strategy 09 Google Sheets Signal Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/yt_learning
Environment=TV_SOURCE_TZ=Asia/Kolkata
EnvironmentFile=/home/ubuntu/yt_learning/strategy_09_sheet_server/.env
ExecStart=/home/ubuntu/yt_learning/.venv/bin/uvicorn strategy_09_sheet_server.server:app --host 0.0.0.0 --port 8010 --workers 1
Restart=always
RestartSec=20
StandardOutput=append:/home/ubuntu/yt_learning/logs/strategy09-sheet-server.log
StandardError=append:/home/ubuntu/yt_learning/logs/strategy09-sheet-server.log

[Install]
WantedBy=multi-user.target
