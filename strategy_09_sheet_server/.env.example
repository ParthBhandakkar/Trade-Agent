SHEET_SERVER_HOST=0.0.0.0
SHEET_SERVER_PORT=8010

SHEET_POLL_SECONDS=60
SHEET_MIN_QUALITY=50
SHEET_FRESH_WINDOW_MINUTES=15
SHEET_BIAS_TTL_HOURS=16
SHEET_BIAS_LOOKBACK_HOURS=72

SHEET_CRYPTO_ONLY=false
SHEET_FOREX_ONLY=true
SHEET_SKIP_SESSION_FILTER=false
SHEET_NO_KILLZONE=false
SHEET_ALLOW_ASIAN=false
SHEET_NO_EMA_FILTER=false
SHEET_NO_BLACKLIST=false

# Optional comma-separated overrides
# SHEET_CRYPTO_PAIRS=BTCUSDT,ETHUSDT,SOLUSDT
# SHEET_FOREX_PAIRS=EURUSD,GBPUSD,XAUUSD

GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_WORKSHEET_TITLE=trade_signals
GOOGLE_SERVICE_ACCOUNT_FILE=/home/ubuntu/yt_learning/strategy_09_sheet_server/google-service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# TradingView credentials used by the existing fetchers
TV_USERNAME=your_tradingview_username
TV_PASSWORD=your_tradingview_password
TV_SESSION_TOKEN=your_tradingview_sessionid_cookie
TV_SOURCE_TZ=Asia/Kolkata

# Optional custom paths
# SHEET_LOG_DIR=/home/ubuntu/yt_learning/strategy_09_sheet_server/logs
# SHEET_STATE_FILE=/home/ubuntu/yt_learning/strategy_09_sheet_server/state/sent_signals.json
